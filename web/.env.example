VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Resend SMTP para Supabase Auth local.
# En produccion se configura en Supabase Dashboard > Authentication > SMTP Settings.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SMTP_ADMIN_EMAIL=notificaciones@cubitat.com

# OAuth social login, only needed when configuring local Supabase Auth providers.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
