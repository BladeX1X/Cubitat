{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/verify-phase2-production-bundle.mjs && node scripts/generate-sitemap.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "audit:react": "npx --yes react-doctor@latest --no-telemetry --no-score .",
    "audit:react:json": "npx --yes react-doctor@latest --no-telemetry --no-score --json --output-dir ./reports/react-doctor .",
    "audit:lighthouse": "npx --yes unlighthouse@latest --config-file unlighthouse.config.js",
    "audit:lighthouse:ci": "npx --yes unlighthouse@latest --config-file unlighthouse.config.js --ci",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:real": "playwright test e2e/real-publish.spec.ts",
    "verify:phase2-bundle": "node scripts/verify-phase2-production-bundle.mjs",
    "seo:sitemap": "node scripts/generate-sitemap.mjs",
    "deploy": "wrangler deploy",
    "cf:deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.5",
    "@radix-ui/react-popover": "^1.1.17",
    "@radix-ui/react-slot": "^1.3.0",
    "@supabase/supabase-js": "^2.110.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.21.0",
    "maplibre-gl": "^5.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.2",
    "happy-dom": "^20.10.6",
    "oxlint": "^1.69.0",
    "postcss": "^8.5.15",
    "sharp": "^0.35.2",
    "supabase": "^2.108.0",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.9",
    "wrangler": "^4.107.0"
  }
}
