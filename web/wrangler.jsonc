{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "src/worker-phase2-production.ts",
  "name": "cubitat1",
  "compatibility_date": "2026-07-03",
  "routes": [
    "cubitathome.com/*",
    "www.cubitathome.com/*"
  ],
  "assets": {
    "directory": "./dist/",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "VITE_SUPABASE_URL": "https://tohjzoncoosvjbjcakdl.supabase.co",
    "PHASE2_AGENTS_ENABLED": "true",
    "PHASE2_IMAGE_DUPLICATES_ENABLED": "true",
    "PHASE3_ENABLED": "false",
    "PUBLIC_SITE_URL": "https://cubitathome.com",
    "ALERT_EMAIL_FROM": "Cubitat <notificaciones@cubitathome.com>",
    "TURNSTILE_VERIFY_URL": "https://turnstile-siteverify-cubitat.pochiprats18.workers.dev",
    "GROQ_MODEL": "qwen/qwen3.8-27b"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "class_name": "RateLimiter"
      }
    ]
  },
  "exports": {
    "RateLimiter": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false
    }
  },
  "triggers": {
    "crons": ["* * * * *"]
  }
}
