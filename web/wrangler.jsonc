{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cubitatdev",
  "compatibility_date": "2026-07-03",
  "routes": [
    "cubitathome.com/*",
    "www.cubitathome.com/*"
  ],
  "assets": {
    "directory": "./dist/",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
